{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MINEMOD_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows"
    },
    {
      "name": "windows-release",
      "inherits": "windows"
    },
    {
      "name": "linux-jni",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MINEMOD_BUILD_JNI_BRIDGE": "ON",
        "MINEMOD_BUILD_TESTS": "OFF",
        "MINEMOD_BUILD_RENDERER": "OFF"
      }
    },
    {
      "name": "windows-jni",
      "inherits": "windows",
      "cacheVariables": {
        "MINEMOD_BUILD_JNI_BRIDGE": "ON",
        "MINEMOD_BUILD_TESTS": "OFF",
        "MINEMOD_BUILD_RENDERER": "OFF"
      }
    },
    {
      "name": "windows-provider",
      "inherits": "windows",
      "cacheVariables": {
        "MINEMOD_BUILD_JNI_BRIDGE": "ON",
        "MINEMOD_BUILD_RENDERER": "OFF"
      }
    },
    {
      "name": "linux-client",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MINEMOD_BUILD_JNI_BRIDGE": "ON",
        "MINEMOD_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-client",
      "inherits": "windows",
      "cacheVariables": {
        "MINEMOD_BUILD_JNI_BRIDGE": "ON",
        "MINEMOD_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-jni",
      "configurePreset": "linux-jni",
      "targets": [
        "minemod_jni",
        "minemod_gl_provider_jni"
      ]
    },
    {
      "name": "windows-jni",
      "configurePreset": "windows-jni",
      "configuration": "RelWithDebInfo",
      "targets": [
        "minemod_jni",
        "minemod_gl_provider_jni"
      ]
    },
    {
      "name": "windows-provider",
      "configurePreset": "windows-provider",
      "configuration": "RelWithDebInfo",
      "targets": [
        "minemod_gl_provider_tests",
        "minemod_gl_provider_jni"
      ]
    },
    {
      "name": "linux-client",
      "configurePreset": "linux-client",
      "targets": [
        "minemod_jni",
        "minemod_gl_provider_jni"
      ]
    },
    {
      "name": "linux-scene-host",
      "configurePreset": "linux-client",
      "targets": [
        "minemod_scene_host_jni"
      ]
    },
    {
      "name": "windows-client",
      "configurePreset": "windows-client",
      "configuration": "RelWithDebInfo",
      "targets": [
        "minemod_jni",
        "minemod_gl_provider_jni"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-provider",
      "configurePreset": "windows-provider",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^gl_provider$"
        }
      }
    }
  ]
}
