{
  "problemMatcher": [
    {
      "owner": "msvc-compiler",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?(error|warning)\\s+(\\w+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "msvc-linker",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*(.+?)\\s*:\\s+(?:fatal\\s+)?(error)\\s+(LNK\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "severity": 2,
          "code": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "doctest",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+:\\s)?\\s*(.+?)\\((\\d+)\\):\\s+(?:FATAL\\s+)?ERROR:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      ]
    }
  ]
}
