  "version": "${version}",
  "name": "MineMod Journey",
  "description": "Drives the game through a planned journey and records what it observed.",
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.luasgraphicss.minemod.journey.JourneyClient"]
  },
  "mixins": ["minemod-journey.mixins.json"],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=21"
  }
}
